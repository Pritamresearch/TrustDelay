      "claim": "Reliability gating provides significant gain over uniform fusion.",
      "measured_drop_pts": 4.15,
      "survives": true,
      "finding": "SURVIVES. Gating provides a +4.15 pts advantage over uniform fusion (9.48% vs 5.33%)."
    },
    "conclusion_3_sigma_input": {
      "claim": "Predicted variance sigma provides an effective gate admission signal.",
      "measured_diff_pts": 1.28,
      "survives": false,
      "finding": "CONTRADICTED. Removing sigma from the gate increases AP@0.5 by +1.28 pts (10.76% vs 9.48%). Sigma input does not provide an effective admission signal."
    },
    "conclusion_4_budget": {
      "claim": "Message compression bounds bandwidth at minimal precision cost.",
      "measured_diff_pts": 2.6,
      "survives": true,
      "finding": "SURVIVES. Transmitting 100 KB uncompressed queries yields 12.08% vs 9.48% at 8.4 KB (diff: +2.60 pts for 1.8x payload)."
